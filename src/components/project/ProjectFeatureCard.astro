---
import { Icon } from "astro-icon/components";
import type { Project } from "@/data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class="card bg-base-200 shadow-lg border border-base-300 overflow-hidden my-6">
  <div class="flex flex-col md:flex-row">
    <!-- 左侧视觉区 -->
    <div class="md:w-1/3 bg-gradient-to-br from-emerald-500/10 to-cyan-500/10 flex items-center justify-center p-8 md:p-12">
      <div class="text-center">
        {project.icon && <Icon name={project.icon} class="w-20 h-20 text-primary mx-auto mb-4" />}
        <p class="text-sm text-base-content/60 font-medium">{project.tags[0] || "Project"}</p>
      </div>
    </div>

    <!-- 右侧详情区 -->
    <div class="md:w-2/3 p-6 md:p-8 flex flex-col justify-between">
      <div>
        <h3 class="text-2xl font-bold mb-2">{project.title}</h3>
        <p class="text-base-content/80 mb-4 leading-relaxed">{project.description}</p>

        <!-- 核心亮点 -->
        {project.highlights && project.highlights.length > 0 && (
          <ul class="space-y-2 mb-6">
            {project.highlights.map((h) => (
              <li class="flex items-start gap-2">
                <Icon name="lucide:check-circle-2" class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" />
                <span class="text-base-content/90">{h}</span>
              </li>
            ))}
          </ul>
        )}

        <!-- 技术栈标签 -->
        <div class="flex flex-wrap gap-2 mb-6">
          {project.tags.map((tag) => (
            <span class="badge badge-primary badge-outline">{tag}</span>
          ))}
        </div>
      </div>

      <!-- 操作按钮 -->
      <div class="flex flex-wrap gap-3 mt-auto">
        <a href={project.github} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary gap-2">
          <Icon name="lucide:github" class="w-4 h-4" />
          <span>Source Code</span>
        </a>
        {project.demo && (
          <a href={project.demo} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline gap-2">
            <Icon name="lucide:external-link" class="w-4 h-4" />
            <span>Live Demo</span>
          </a>
        )}
      </div>
    </div>
  </div>
</div>
