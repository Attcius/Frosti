---
import { Code } from "astro-expressive-code/components";
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import FeatureCard from "@/components/mdx/FeatureCard.astro";
import GitHubStats from "@/components/mdx/GitHubStats.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Home">
  <MainCard
    title="欢迎来到我的博客"
    description="一名地信专业学生，分享 GIS 开发实践、前端技术探索、地信学习笔记，记录从理论到项目的成长之路。"
    textOverlay="HOME"
    infoIcon="lucide:info"
  >
    <div class="space-y-8">
      <!-- Hero Section -->
      <!-- Hero Section -->
      <section class="py-12 md:py-20 bg-base-100 relative overflow-hidden">
        <!-- 可选：添加微妙的背景网格/光晕，增加科技感 -->
        <div
          class="absolute inset-0 bg-[radial-gradient(circle_at_50%_120%,rgba(59,130,246,0.08),transparent_60%)] pointer-events-none"
        >
        </div>

        <div
          class="max-w-4xl mx-auto px-4 flex flex-col items-center text-center relative z-10"
        >
          <!-- 1. 头像 (移到最上方) -->
          <div class="avatar mb-4">
            <div
              class="w-28 h-28 md:w-32 md:h-32 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2 shadow-lg transition-transform hover:scale-105 duration-300"
            >
              <img
                src="https://106.53.211.124:36298/down/HRUkG0GdlJnI.jpg"
                alt="Atticus"
                width="128"
                height="128"
                loading="eager"
              />
            </div>
          </div>

          <!-- 2. 身份标签 (移到头像下面) -->
          <div
            class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-medium mb-6"
          >
            <Icon name="lucide:compass" class="w-4 h-4" />
            <span>WebGIS Developer & Explorer</span>
          </div>

          <!-- 主标题：强调核心关键词 -->
          <h1
            class="text-3xl md:text-5xl font-bold mb-5 leading-tight tracking-tight"
          >
            探索<span
              class="bg-gradient-to-r from-blue-500 to-cyan-600 bg-clip-text text-transparent"
              >空间数据</span
            >与<span
              class="bg-gradient-to-r from-blue-500 to-cyan-600 bg-clip-text text-transparent"
              >现代前端</span
            >的交汇
          </h1>

          <!-- 副标题/个人简介 -->
          <p
            class="text-lg md:text-xl text-base-content/70 max-w-2xl mb-8 leading-relaxed"
          >
            我是 Atticus，专注于 WebGIS 开发与空间可视化。在这里，我分享从
            OGC 标准到 Vue/TS
            工程化的实战心得，记录用代码重塑地理智慧的技术之旅。
          </p>

          <!-- 行动按钮组 -->
          <div class="flex flex-wrap gap-4 justify-center">
            <!-- 主要 CTA：关于我 -->
            <a
              href="/about"
              class="btn btn-primary gap-2 shadow-md shadow-primary/20 hover:shadow-lg hover:shadow-primary/30 transition-all"
            >
              <Icon name="lucide:user" class="w-5 h-5" />
              <span>关于我</span>
            </a>

            <!-- 次要 CTA：查看项目 -->
            <a
              href="#projects"
              class="btn btn-outline gap-2 hover:btn-primary transition-colors"
            >
              <Icon name="lucide:folder-open" class="w-5 h-5" />
              <span>专注领域</span>
            </a>

            <!-- 辅助入口 -->
            <a
              href="#blog"
              class="btn btn-ghost gap-2 text-base-content/60 hover:text-primary"
            >
              <Icon name="lucide:book-open" class="w-5 h-5" />
              <span>最新博客</span>
            </a>

            <a
              href="https://github.com/Zoeylee0723"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost gap-2 text-base-content/60 hover:text-primary"
            >
              <Icon name="lucide:github" class="w-5 h-5" />
              <span>GitHub</span>
            </a>
          </div>

          <!-- 新增：底部致谢语 -->
          <div
            class="mt-10 text-sm text-base-content/40 hover:text-base-content/60 transition-colors"
          >
            感谢 <a
              href="https://github.com/EveSunMaple"
              target="_blank"
              rel="noopener noreferrer"
              class="link link-hover hover:text-primary">EveSunMaple</a
            > 的开源，本博客基于 <a
              href="https://github.com/EveSunMaple/Frosti"
              target="_blank"
              rel="noopener noreferrer"
              class="link link-hover hover:text-primary">Frosti</a
            > 改造
          </div>
        </div>
      </section>

      <!-- Focus Areas Section (Bento Grid Layout) -->
      <section id="projects" class="py-8 bg-base-100">
        <div class="max-w-5xl mx-auto px-4">
          <h2
            class="text-3xl font-bold text-center mb-8 flex items-center gap-2 text-primary"
          >
            <Icon name="lucide:folder-open" class="w-8 h-8" />
            专注领域
          </h2>

          <!-- Bento Grid 容器 -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- 左上角：大概介绍 (横跨2列) -->
            <div
              class="md:col-span-2 bg-base-200 rounded-lg p-8 flex flex-col justify-center hover:bg-base-300/50 transition-colors"
            >
              <h3 class="text-2xl font-bold mb-4">探索空间与代码的交汇点</h3>
              <p class="text-base-content/80 leading-relaxed">
                我是 SunMaple，一名专注 WebGIS
                与前端工程的开发者。我相信地理空间数据的力量不应局限于桌面软件，通过现代
                Web 技术（Vue, OpenLayers, PostGIS）与 AI
                工具的深度融合，我致力于构建优雅、高效且具有互操作性的空间应用，让复杂的空间逻辑在浏览器中焕发生机。
              </p>
            </div>

            <!-- 右上角：卡片1-GIS开发 -->
            <div
              class="bg-base-100 rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow flex flex-col justify-between border border-base-300/50"
            >
              <div>
                <div
                  class="w-10 h-10 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center mb-4"
                >
                  <Icon name="lucide:globe" class="w-6 h-6" />
                </div>
                <h4 class="text-xl font-bold mb-2">GIS 开发</h4>
                <p class="text-gray-600 text-sm">
                  深耕 OGC 标准，熟练使用 OpenLayers / GeoServer 构建 WebGIS
                  应用，具备 WFS-T 交互与三维数据加载实战经验。
                </p>
              </div>
              <div class="mt-4 flex flex-wrap gap-2">
                <span class="bg-blue-50 text-blue-700 text-xs px-2 py-1 rounded"
                  >OpenLayers</span
                >
                <span class="bg-blue-50 text-blue-700 text-xs px-2 py-1 rounded"
                  >GeoServer</span
                >
                <span class="bg-blue-50 text-blue-700 text-xs px-2 py-1 rounded"
                  >OGC</span
                >
              </div>
            </div>

            <!-- 左下角：卡片2-前端技术 -->
            <div
              class="bg-base-100 rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow flex flex-col justify-between border border-base-300/50"
            >
              <div>
                <div
                  class="w-10 h-10 rounded-lg bg-green-100 text-green-600 flex items-center justify-center mb-4"
                >
                  <Icon name="lucide:layout" class="w-6 h-6" />
                </div>
                <h4 class="text-xl font-bold mb-2">前端技术</h4>
                <p class="text-gray-600 text-sm">
                  以 Vue.js 为核心，结合 Vite 与 TypeScript
                  构建高效响应式应用，深度拥抱 AI
                  辅助编程，注重组件化与工程化实践。
                </p>
              </div>
              <div class="mt-4 flex flex-wrap gap-2">
                <span
                  class="bg-green-50 text-green-700 text-xs px-2 py-1 rounded"
                  >Vue.js</span
                >
                <span
                  class="bg-green-50 text-green-700 text-xs px-2 py-1 rounded"
                  >TypeScript</span
                >
                <span
                  class="bg-green-50 text-green-700 text-xs px-2 py-1 rounded"
                  >Vite</span
                >
              </div>
            </div>

            <!-- 右下角：卡片3-空间分析 (横跨2列，内部左右布局) -->
            <div
              class="md:col-span-2 bg-base-100 rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow flex flex-col md:flex-row gap-6 border border-base-300/50"
            >
              <!-- 左侧文字 -->
              <div class="flex-1">
                <div
                  class="w-10 h-10 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center mb-4"
                >
                  <Icon name="lucide:scan" class="w-6 h-6" />
                </div>
                <h4 class="text-xl font-bold mb-2">空间分析</h4>
                <p class="text-gray-600 text-sm">
                  打通前后端空间计算链路，结合 PostGIS 与 Turf.js
                  实现数据入库、服务发布与前端可视化分析的闭环，具备桌面端与 B/S
                  联合建模能力。
                </p>
                <div class="mt-4 flex flex-wrap gap-2">
                  <span
                    class="bg-purple-50 text-purple-700 text-xs px-2 py-1 rounded"
                    >PostGIS</span
                  >
                  <span
                    class="bg-purple-50 text-purple-700 text-xs px-2 py-1 rounded"
                    >Turf.js</span
                  >
                  <span
                    class="bg-purple-50 text-purple-700 text-xs px-2 py-1 rounded"
                    >ArcPy</span
                  >
                </div>
              </div>
              <!-- 右侧装饰性图标/留白，增加设计感 -->
              <div
                class="hidden md:flex items-center justify-center w-1/3 text-primary/20"
              >
                <Icon name="lucide:workflow" class="w-24 h-24" />
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </MainCard>
</BaseLayout>
