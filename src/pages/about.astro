---
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import TechSection from "@/components/TechSection.astro";
import {
  engineeringTech,
  frontendLibs,
  frontendTech,
  gisTech,
  others,
  visualizationTech,
} from "@/data/techStack";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="About">
  <MainCard
    title="关于我"
    description="关于我"
    textOverlay="ABOUT"
    infoIcon="lucide:user"
  >
    <div class="space-y-10 mb-8">
      <!-- Profile Section -->
      <section
        class="flex flex-col md:flex-row gap-8 items-center md:items-start"
      >
        <div class="avatar">
          <div
            class="w-32 h-32 md:w-40 md:h-40 rounded-xl ring ring-primary ring-offset-base-100 ring-offset-2 overflow-hidden"
          >
            <img
              src="/avatar.png"
              alt="Atticus"
              width="160"
              height="160"
              loading="eager"
            />
          </div>
        </div>

        <div class="flex-1 text-center md:text-left">
          <h1 class="text-3xl md:text-4xl font-bold mb-2">Atticus</h1>
          <p class="text-xl text-base-content/80 mb-4">
            Developer & Open-Source Enthusiast
          </p>

          <div
            class="flex flex-wrap gap-3 justify-center md:justify-start mb-6"
          >
            <!-- GitHub 按钮：更新链接 -->
            <a
              href="https://github.com/Attcius"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-sm btn-outline gap-2"
            >
              <Icon name="lucide:github" class="w-4 h-4" />
              <span>GitHub</span>
            </a>

            <a
              href="https://gitee.com/zoey0723"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-sm btn-outline gap-2"
            >
              <Icon name="simple-icons:gitee" class="w-4 h-4" />
              <span>Gitee</span>
            </a>

            <!-- Bilibili 按钮：新增，替换原 Twitter -->
            <a
              href="https://space.bilibili.com/125111176"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-sm btn-outline gap-2"
            >
              <!-- 使用 simple-icons 显示 B站图标，如果没有显示可换成 lucide:tv -->
              <Icon name="simple-icons:bilibili" class="w-4 h-4" />
              <span>Bilibili</span>
            </a>

            <!-- Email 按钮：更新邮箱 -->
            <a
              href="mailto:oeah38@163.com"
              class="btn btn-sm btn-outline gap-2"
            >
              <Icon name="lucide:mail" class="w-4 h-4" />
              <span>Email</span>
            </a>
          </div>

          <p class="text-base-content/80">
            你好！我是 Atticus，一个地理信息系统专业学生，专注于 GIS
            开发、前端技术和开源项目。
          </p>
        </div>
      </section>

      <!-- GitHub Stats
      <section>
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:github" class="w-6 h-6 text-primary" />
          <span>GitHub Statistics</span>
        </h2>

        <GitHubStats
          username="Attcius"
          showLanguages={false}
          showCommitGraph={true}
        />
      </section> -->

      <!-- Tech Stack -->
      <section>
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:code-2" class="w-6 h-6 text-primary" />
          <span>技术栈</span>
        </h2>

        <div class="space-y-8">
          <TechSection
            title="Web 基础与语言"
            iconName="lucide:layout"
            items={frontendTech}
          />
          <TechSection
            title="前端框架与生态"
            iconName="lucide:boxes"
            items={frontendLibs}
          />
          <TechSection
            title="数据可视化与图形"
            iconName="lucide:layers"
            items={visualizationTech}
          />
          <TechSection
            title="GIS 与空间数据"
            iconName="lucide:map"
            items={gisTech}
          />
          <TechSection
            title="工程化与协作"
            iconName="lucide:wrench"
            items={engineeringTech}
          />
          <TechSection
            title="其他（服务端、数据库与部署）"
            iconName="lucide:server"
            items={others}
          />
        </div>
      </section>
    </div>
  </MainCard>
</BaseLayout>
