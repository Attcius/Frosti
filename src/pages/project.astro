---
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import ProjectFeatureCard from "@/components/project/ProjectFeatureCard.astro";
import ProjectNormalCard from "@/components/project/ProjectNormalCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projects } from "@/data/projects";
// 定义分类的元数据（标题和图标）
const categories = [
  { key: "gis", title: "GIS & Spatial", icon: "lucide:map" },
  { key: "frontend", title: "Frontend Development", icon: "lucide:monitor-smartphone" },
  { key: "other", title: "Other Experiments", icon: "lucide:flask-conical" },
] as const;
// 根据分类过滤项目
const getProjectsByCategory = (category: string) => projects.filter((p) => p.category === category);
---


<BaseLayout title="Projects">
  <MainCard
    title="项目"
    description="项目"
    textOverlay="PROJECTS"
    infoIcon="lucide:code-2"
  >
    {categories.map((cat) => {
      const catProjects = getProjectsByCategory(cat.key);
      
      // 如果该分类下没有项目，就不渲染这个板块
      if (catProjects.length === 0) return null;

      return (
        <section class="py-4 mt-8">
          <h2 class="text-2xl font-bold mb-2 flex items-center gap-2">
            <Icon name={cat.icon} class="w-6 h-6 text-primary" />
            <span>{cat.title}</span>
          </h2>

          {/* 判断是否有 featured 项目，决定用哪种布局 */}
          {catProjects.some((p) => p.featured) ? (
            // 如果有大卡片项目，使用单列布局混合渲染
            <div class="space-y-6 mt-6">
              {catProjects.map((project) =>
                project.featured ? (
                  <ProjectFeatureCard {project} />
                ) : (
                  <ProjectNormalCard {project} />
                )
              )}
            </div>
          ) : (
            // 如果全是普通项目，使用网格布局
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
              {catProjects.map((project) => (
                <ProjectNormalCard {project} />
              ))}
            </div>
          )}
        </section>
      );
    })}
  </MainCard>
</BaseLayout>
