---
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import FriendCard from "@/components/mdx/FriendCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

// ==================== 友链数据配置 ====================

// 本站信息（新增）
const mySiteInfo = {
  name: "你的站点名称", // 替换为你的站点名
  avatar: "https://api.iconify.design/lucide:smile.svg", // 替换为你的头像链接
  url: "https://your-domain.com", // 替换为你的域名
  description: "这里是你的个人简介或站点介绍" // 替换为你的简介
};

// 友链列表数据
const friends = [
  {
    name: "我的B站",
    avatar: "https://api.iconify.design/simple-icons:bilibili.svg",
    description: "欢迎关注我的B站账号！",
    url: "https://space.bilibili.com/125111176?spm_id_from=333.337.0.0",
  },
  // 下方添加更多友链
  {
    name: "友链占位 1",
    avatar: "https://api.iconify.design/lucide:user.svg",
    description: "这里填写友链介绍...",
    url: "#",
  },
  {
    name: "友链占位 2",
    avatar: "https://api.iconify.design/lucide:user.svg",
    description: "这里填写友链介绍...",
    url: "#",
  }
];

// ==================== 页面结构 ====================
---

<BaseLayout title="Friends">
  <MainCard
    title="Friends"
    description="山水一程，三生有幸。以下是我在网络上结识的朋友们。"
    textOverlay="FRIENDS"
    infoIcon="lucide:link"
  >
    <div class="space-y-10">
      
      {/* 本站信息模块 - 方便别人和你交换友链 */}
      <section>
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:home" class="w-6 h-6 text-primary" />
          <span>本站信息</span>
        </h2>
        <div class="p-6 border border-base-300 rounded-xl bg-base-200/30 flex flex-col sm:flex-row items-center gap-6">
          <img 
            src={mySiteInfo.avatar} 
            alt={mySiteInfo.name} 
            class="w-24 h-24 rounded-full shadow-lg border-2 border-primary/50" 
          />
          <div class="flex-1 text-center sm:text-left">
            <h3 class="text-xl font-bold">{mySiteInfo.name}</h3>
            <p class="text-base-content/70 mt-1 mb-3">{mySiteInfo.description}</p>
            <a 
              href={mySiteInfo.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="btn btn-sm btn-primary btn-outline"
            >
              <Icon name="lucide:external-link" class="w-4 h-4" />
              访问站点
            </a>
          </div>
        </div>
      </section>

      <div class="divider"></div>

      {/* 友链列表 */}
      <section>
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:users" class="w-6 h-6 text-primary" />
          <span>友情链接</span>
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          {friends.map((friend) => (
            <FriendCard
              name={friend.name}
              avatar={friend.avatar}
              description={friend.description}
              url={friend.url}
              type="friend"
            />
          ))}
        </div>
      </section>

      <div class="divider my-8">
        <Icon name="lucide:heart" class="w-10 h-10 text-primary" />
      </div>

      {/* 申请方式 */}
      <div class="text-center">
        <p class="text-base-content/80 mb-4">
          想要交换友链？欢迎在评论区留言或通过邮件联系我！
        </p>
        {/* 你可以替换 href 为你的留言板地址或邮件地址 */}
        <a
          href="mailto:your-email@example.com"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary gap-2"
        >
          <Icon name="lucide:mail" class="w-5 h-5" />
          <span>申请友链</span>
        </a>
      </div>
    </div>
  </MainCard>
</BaseLayout>
